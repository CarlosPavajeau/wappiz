load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "plans",
    srcs = ["service.go"],
    importpath = "wappiz/internal/services/plans",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/services/featureflags",
        "//pkg/codes",
        "//pkg/db",
        "//pkg/fault",
        "@com_github_google_uuid//:uuid",
