)

go_test(
    name = "plans_test",
    srcs = ["service_test.go"],
    embed = [":plans"],
    deps = [
        "//internal/services/featureflags",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//require",
    ],
)
