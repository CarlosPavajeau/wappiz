# Copy to .env.docker for `docker compose up`. DATABASE_URL and REDIS_URL are
# set by docker-compose.yml. These placeholders boot the API; outbound
# WhatsApp and email calls fail (and are logged) until real keys are set.

ENVIRONMENT=sandbox
ADMIN_EMAIL=admin@localhost

# Must be exactly 32 bytes.
ENCRYPTION_KEY=local-dev-key-0123456789abcdefgh

WEBHOOK_VERIFY_TOKEN=local-verify-token
WHATSAPP_APP_SECRET=local-app-secret

RESEND_API_KEY=re_local_placeholder
RESEND_FROM_EMAIL=wappiz@localhost

# Cloudflare's test secret: every token passes. Pair it with the test site
# key 1x00000000000000000000AA in the web app.
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# JWTs are issued by the web app (Better Auth); leave empty to skip the
# issuer check, or set it to the web app's BETTER_AUTH_URL.
JWT_ISSUER=
